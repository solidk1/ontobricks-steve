# OntoBricks Environment Configuration
# Copy this file to .env and fill in your values
#
# NOTE: For Databricks Apps deployment, most of these are set automatically
# by the platform. This file is primarily for LOCAL development.
#
# ── Quick start ──────────────────────────────────────────────────────────────
# 1. Copy:  cp .env.example .env
# 2. Fill in DATABRICKS_HOST, one auth method (PAT recommended), and the
#    Lakebase / UC Volume coordinates below.
# 3. Run:   ./scripts/start.sh
# -----------------------------------------------------------------------------

# ============================================================================
# Databricks Connection (Required)
# ============================================================================
# Your Databricks workspace URL
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com

# ── Authentication — choose ONE ──────────────────────────────────────────────
#
# Option A (recommended for local dev): Personal Access Token
#   Generate at: Workspace → User Settings → Developer → Access Tokens
#   Leave blank if using Option B.
DATABRICKS_TOKEN=

# Option B: Databricks CLI OAuth profile
#   If DATABRICKS_TOKEN is blank, OntoBricks resolves credentials from
#   ~/.databrickscfg at runtime (via the Databricks SDK). scripts/start.sh
#   can also call `databricks auth token --profile <DATABRICKS_CONFIG_PROFILE>`
#   to inject a short-lived token into the process environment.
#
#   Prerequisites:
#     1. Install the Databricks CLI  (brew install databricks)
#     2. Authenticate once:  databricks auth login --profile <profile-name>
#     3. Set the profile name below (must match ~/.databrickscfg exactly).
#
#   If your ~/.databrickscfg has two profiles pointing at the same host
#   you MUST set this to pick one — otherwise the SDK raises an ambiguity error.
#
DATABRICKS_CONFIG_PROFILE=DEFAULT

# SQL Warehouse ID for query execution
# Find at: Workspace → SQL → SQL Warehouses → (select) → Connection details
DATABRICKS_SQL_WAREHOUSE_ID=

# ============================================================================
# Registry Backend — PostgreSQL
# ============================================================================
REGISTRY_BACKEND=lakebase

# OntoBricks installs into an EXISTING database as ONE NEW SCHEMA and touches
# nothing outside it, so `DROP SCHEMA <schema> CASCADE` removes it completely.
# No extensions are required (PostgreSQL 14+ is the floor).
#
# There is ONE set of connection variables for every server — Azure Database for
# PostgreSQL, Databricks Lakebase, or anything else. Lakebase is a PostgreSQL
# endpoint like any other; the only thing that differs is how the password is
# produced, which ONTOBRICKS_PG_AUTH selects. The old LAKEBASE_SCHEMA /
# LAKEBASE_DATABASE / LAKEBASE_PROJECT / LAKEBASE_BRANCH variables are retired.
#
PGHOST=
PGPORT=5432
PGDATABASE=ontobricks
PGUSER=
PGSSLMODE=require           # Azure mandates TLS; prefer verify-full in prod
ONTOBRICKS_PG_SCHEMA=ontobricks
# ONTOBRICKS_PG_DATABASE=   # optional: registry in a different database
# ONTOBRICKS_PG_POOL_MIN=1
# ONTOBRICKS_PG_POOL_MAX=8

# ── How the password is produced ────────────────────────────────────────────
#
#   entra     Microsoft Entra ID access token, minted per physical connection
#             (tokens live 5-60 min and cannot be refreshed in-session).
#             DefaultAzureCredential resolves a container's managed identity in
#             a deployment and your `az login` session locally, so no database
#             secret is stored. Requires a one-time
#             `SELECT * FROM pgaadauth_create_principal('<name>', false, false)`
#             plus CREATE on the schema. This is the default when PGHOST ends
#             in .postgres.database.azure.com.
#   lakebase  Short-lived JWT minted from the Databricks Postgres API. Point
#             PGHOST at the Lakebase endpoint hostname (Compute -> Lakebase ->
#             <branch> -> Connection details).
#   password  Plain PGPASSWORD.
#
# ONTOBRICKS_PG_AUTH=entra
# AZURE_CLIENT_ID=          # only for a USER-assigned managed identity
# PGPASSWORD=               # only when ONTOBRICKS_PG_AUTH=password

# ============================================================================
# Unity Catalog Volume — binary artefacts (domain document uploads)
# ============================================================================
# The domain registry lives in Lakebase (above). The Volume is only used for
# binary attachments (documents imported by the ontology designer).
# Full path: /Volumes/<REGISTRY_CATALOG>/<REGISTRY_SCHEMA>/<REGISTRY_VOLUME>
# In Databricks Apps the volume resource is auto-bound.
REGISTRY_CATALOG=
REGISTRY_SCHEMA=
REGISTRY_VOLUME=

# ============================================================================
# Authentication — OIDC login (Databricks as the identity provider)
# ============================================================================
# Off the Databricks Apps platform there are no x-forwarded-* identity headers,
# so OntoBricks runs the OAuth 2.0 authorization-code + PKCE flow itself against
# a Databricks *custom OAuth app integration* (account console → App
# connections). One login yields the user's email, their groups, and a
# Databricks user token — the last of which enables per-user Unity Catalog
# enforcement on interactive queries.
#
# Register the integration with this exact redirect URI, then:
# ONTOBRICKS_OIDC_CLIENT_ID=
# ONTOBRICKS_OIDC_CLIENT_SECRET=          # omit for a public (PKCE-only) client
# ONTOBRICKS_OIDC_REDIRECT_URI=https://<your-host>/auth/callback
# ONTOBRICKS_OIDC_SCOPES=all-apis offline_access
#
# ONTOBRICKS_AUTH_ENABLED defaults to TRUE (fail closed): a deployment that
# configures nothing is locked, not served unauthenticated. Turn it off only for
# local development.
# ONTOBRICKS_AUTH_ENABLED=false
#
# The first admin, seeded into the registry `app_roles` table on first use.
# Without it a fresh deployment has no admin and nobody can grant one.
# Applied only while no admin exists, so a deliberate revoke is not undone.
# ONTOBRICKS_BOOTSTRAP_ADMIN=you@example.com

# ============================================================================
# LLM provider — agents and SQL Wizard (Required for AI features)
# ============================================================================
# One shape, one credential, one URL:
#
#   POST {ONTOBRICKS_LLM_BASE_URL}/chat/completions
#   Authorization: Bearer {ONTOBRICKS_LLM_API_KEY}
#   {"model": "{ONTOBRICKS_LLM_MODEL}", "messages": [...]}
#
# Nothing is inferred. A configured Databricks workspace is NOT an LLM provider:
# it stays connected for Unity Catalog reads and the Delta engine, and the model
# call still requires the variables below. If they are unset, AI features fail
# with an error naming the variable rather than quietly picking a provider.
#
# Give the base URL, not the full endpoint (a pasted .../chat/completions is
# tolerated rather than doubled):
#
#   OpenAI:        https://api.openai.com/v1
#   Azure OpenAI:  https://<res>.openai.azure.com/openai/deployments/<deployment>
#   Databricks:    https://<workspace>/serving-endpoints
#   vLLM:          http://vllm:8000/v1
#   Ollama:        http://localhost:11434/v1
#   LiteLLM:       https://<proxy>/v1
#
ONTOBRICKS_LLM_BASE_URL=
#
# Omit entirely for an unauthenticated local provider — Ollama and a bare vLLM
# reject a Bearer header carrying nothing. For Databricks, a PAT or OAuth token.
# ONTOBRICKS_LLM_API_KEY=
#
# The model name sent in the request body. On Databricks this is the
# serving-endpoint name (e.g. databricks-claude-sonnet-4).
ONTOBRICKS_LLM_MODEL=
#
# Optional comma-separated list offered in the Domain Settings picker, letting a
# domain select a model other than the default above. Most OpenAI-compatible
# providers have no listing endpoint worth querying, so the choices are declared
# rather than discovered.
# ONTOBRICKS_LLM_MODELS=gpt-4o-mini,gpt-4o
#
# Embedding model, on the same provider and key as above. Only the four
# *semantic* ontology-pitfall checks use it (P4.2 / P4.4 / P4.5 and the P10
# candidate pass), which compare label and comment meaning by cosine similarity.
#
# Set this and those checks need no extra dependency. Leave it unset and they
# fall back to running sentence-transformers in-process, which requires the
# `pitfalls` extra and brings PyTorch: the image goes from 0.50 GB to 6.02 GB
# (measured), at which size cold starts and rollouts stall on PullingImage.
#
# CHOOSE THE MODEL WITH CARE. The checks compare against absolute thresholds
# (0.8), and each model has its own cosine distribution.
# `tests/eval/run_pitfalls_embedders.py --live --compare-local` measures it; on a
# labelled probe set of synonym vs unrelated ontology labels:
#
#   databricks-gte-large-en        F1 1.00  margin 0.333  RECOMMENDED
#   databricks-qwen3-embedding-0-6b  margin 0.298  separable, but a thin gap
#   databricks-bge-large-en          margin 0.166  OVERLAPS — do not use
#   all-MiniLM-L6-v2 (in-process)  F1 0.50  the incumbent; misses 4 of 6 synonyms
#
# gte-large-en beats the in-process model at the same 0.8 threshold with no false
# positives, so the thresholds transfer unchanged. bge-large-en cannot separate
# synonyms from unrelated pairs at any threshold on that probe set.
# ONTOBRICKS_EMBEDDING_MODEL=databricks-gte-large-en

# ============================================================================
# MLflow Tracing (Optional — for AI agent features)
# ============================================================================
# Send agent traces to your Databricks workspace instead of local mlflow.db.
# Requires DATABRICKS_HOST and a valid auth method above.
# MLFLOW_TRACKING_URI=databricks
# ONTOBRICKS_MLFLOW_EXPERIMENT=ontobricks-agents

# ============================================================================
# Application Settings (Optional)
# ============================================================================
# Secret key for session encryption (use a strong random string in production)
SECRET_KEY=your-secret-key-change-in-production

# Application port. Nothing reads DATABRICKS_APP_PORT any more; a test in
# tests/units/core/test_runtime_env.py asserts it stays gone.
# PORT=8000
